# Copy to backend/.env for local development. Never commit .env.
# Every variable is optional unless marked required — defaults suit local dev.

# --- LLM backend ---
# "ollama" (local inference), "anthropic" (hosted), or "stub" (no inference).
# "stub" returns deterministic canned extractions for load testing / offline
# demos (#10) — never use it in production.
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
ANTHROPIC_MODEL=claude-sonnet-5
# Required when LLM_PROVIDER=anthropic — startup fails fast without it
#ANTHROPIC_API_KEY=sk-ant-...
LLM_TEMPERATURE=0.0
# Artificial per-call latency (seconds) for LLM_PROVIDER=stub. 0 measures pure
# app overhead; a non-zero value models a slow backend under load.
STUB_LATENCY_SECONDS=0
# Price table for the cost accounting (#101): "model=input/output" in USD per
# million tokens, comma-separated. "=" rather than ":" because Ollama model ids
# contain a colon (qwen2.5:7b). A model with no entry reports its tokens at zero
# cost — right for a local model, and why only the hosted ones are listed.
# Matched exactly first, then by longest prefix, so a dated snapshot inherits its
# family's price. Prices change: override here rather than editing app/config.py.
#LLM_PRICES=claude-opus-5=5/25,claude-sonnet-5=3/15,claude-haiku-4-5=1/5

# --- API ---
# Comma-separated allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# --- API hardening ---
# Max upload size in bytes (default 25 MiB). Oversized uploads are rejected 413.
MAX_UPLOAD_BYTES=26214400
# Content-type allowlist for uploads (comma-separated). Generic/empty types fall
# back to a .pdf/.md/.txt filename-extension check.
UPLOAD_CONTENT_TYPES=application/pdf,text/markdown,text/plain
# IP-keyed rate limits ("N/second|minute|hour"). Strict on create, generous on reads,
# tight on login (the one endpoint an attacker can guess against).
RATE_LIMIT_CREATE=10/minute
RATE_LIMIT_READ=120/minute
RATE_LIMIT_LOGIN=10/minute
# Set false to disable rate limiting entirely (the test suite does this).
RATE_LIMIT_ENABLED=true
# Concurrent in-flight screenings per instance; excess requests get 429 + Retry-After.
MAX_CONCURRENT_SCREENINGS=4
CONCURRENCY_RETRY_AFTER_SECONDS=5
# SSE heartbeat cadence and idle-reap timeout (seconds).
SSE_HEARTBEAT_SECONDS=15
SSE_IDLE_TIMEOUT_SECONDS=120

# --- Auth (#50) ---
# Gate the human-in-the-loop approval step to authorized reviewers. Set false only
# for single-user local runs or the load-test harness: with auth off every request
# is treated as "anonymous@auth-disabled" with the admin role.
AUTH_ENABLED=true
# HMAC key for session cookies. Unset = a random per-process key: sessions die on
# restart and replicas reject each other's cookies. REQUIRED in production —
# generate one with `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
#AUTH_SECRET=
# Accounts: comma- or newline-separated "email:role:password_hash" entries, where
# role is `reviewer` (can clear the approval gate) or `admin` (that plus managing
# accounts and rules). Mint a hash with `python -m app.auth hash`. Setting this
# REPLACES the demo accounts below rather than adding to them.
#AUTH_USERS=reviewer@example.com:reviewer:scrypt$16384$8$1$...,admin@example.com:admin:scrypt$16384$8$1$...
# Seed the built-in demo accounts (reviewer@trialgate.local / trialgate-reviewer,
# admin@trialgate.local / trialgate-admin — passwords published in the README)
# when AUTH_USERS is empty. Keeps the zero-config demo usable; set false in
# production, where AUTH_USERS must be provided instead.
AUTH_DEMO_USERS=true
# Session lifetime in seconds (default 8h — a reviewer's shift).
AUTH_SESSION_TTL_SECONDS=28800
AUTH_COOKIE_NAME=trialgate_session
# Add the cookie's Secure attribute (HTTPS-only). Leave false for plain-HTTP local
# dev, where a Secure cookie would never be stored; set true behind TLS.
AUTH_COOKIE_SECURE=false

# --- Notify on gate / escalation (#60) ---
# Push a notification when a run parks at the approval gate or escalates, so
# reviewers don't have to poll the runs index. Off by default; turning it on
# requires at least one channel below (startup fails otherwise, rather than
# no-op'ing silently). Notifications carry metadata only — run id, status,
# protocol filename, criteria count, link — never patient or criteria detail.
NOTIFY_ENABLED=false
# Channel 1: Slack-compatible incoming webhook (or any JSON POST endpoint).
#NOTIFY_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/xxxx
# Channel 2: email. All three are required together.
#NOTIFY_EMAIL_TO=reviewers@example.com,oncall@example.com
#NOTIFY_EMAIL_FROM=trialgate@example.com
#NOTIFY_SMTP_HOST=smtp.example.com
NOTIFY_SMTP_PORT=587
#NOTIFY_SMTP_USERNAME=
#NOTIFY_SMTP_PASSWORD=
# STARTTLS before AUTH. Set false only for a plaintext relay on a trusted
# network (a local MTA, or MailHog in dev).
NOTIFY_SMTP_STARTTLS=true
# Per-channel ceiling in seconds — also the worst case a notification can add to
# a run's completion, since it is dispatched on the run's own task.
NOTIFY_TIMEOUT_SECONDS=5
# Public frontend URL, used to build a clickable link to the run. Unset omits the
# link rather than guessing a host.
#NOTIFY_BASE_URL=https://trialgate.example.com

# --- Pipeline ---
# How many Parser attempts before the Critic escalates to a human (1-10)
MAX_PARSE_ATTEMPTS=3
# Override data locations if needed (defaults live under backend/app/)
#RULES_PATH=/path/to/compliance_rules.yaml
#PATIENTS_PATH=/path/to/patients.json

# --- Persistence ---
# Where LangGraph execution state + screening metadata live.
#   memory   = process-local, lost on restart (tests only)
#   sqlite   = durable single-node default
#   postgres = multi-replica production (install the extra: pip install -e ".[postgres]")
CHECKPOINT_BACKEND=sqlite
# sqlite file (both the checkpointer and the screening store share it)
#SQLITE_PATH=/path/to/screenings.sqlite
# Required when CHECKPOINT_BACKEND=postgres — startup fails fast without it
#POSTGRES_DSN=postgresql://user:pass@localhost:5432/screener

# --- Observability ---
# Expose Prometheus metrics at GET /metrics. Custom domain metrics are always
# recorded; this only gates the scrape endpoint. Set false to unmount it.
METRICS_ENABLED=true
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# "console" = human-readable, colorized (dev); "json" = one object per line (prod)
LOG_FORMAT=console
